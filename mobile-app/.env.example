# Copy to .env. Local Firebase emulators (firebase/functions: npm run serve).
# 10.0.2.2 = this PC as seen from the Android emulator; use the PC's LAN IP for a real phone.
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2

# Real Firebase project (set USE_EMULATORS=false):
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
