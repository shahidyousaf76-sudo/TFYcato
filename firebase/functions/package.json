{
  "name": "tfy-cat-adventure-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest test/unit",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-tfy-cat --only auth,firestore,functions \"npm run jest:emulator\"",
    "jest:emulator": "jest test/emulator --runInBand",
    "export-content": "ts-node scripts/export-content.ts",
    "seed:emulator": "ts-node scripts/seed.ts --emulator",
    "seed": "ts-node scripts/seed.ts",
    "serve": "npm run build && firebase emulators:start --project demo-tfy-cat --only auth,firestore,functions",
    "deploy": "npm run build && firebase deploy --only functions,firestore"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
